* text=auto eol=lf

# Generated artifacts. A textual 3-way merge of two generator outputs yields a
# file no generator emitted: an MJCF the sim mis-simulates, or a gain header
# matching no validated run. merge=binary keeps one side and conflicts instead.
# Resolve by re-running the generator, never hunk by hunk.
sim/generated/seeded/latest/**                               merge=binary linguist-generated=true
firmware/finn-mcu/control/04_lqr_balance/lqr_seeded_config.h merge=binary linguist-generated=true
uv.lock                                                      merge=binary linguist-generated=true

*.stl binary
