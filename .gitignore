# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
*.egg
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ipynb_checkpoints/

# ---- uv / venv ----
.venv/
venv/
env/
# uv.lock stays committed for reproducible installs across Mac and Linux.

# ---- Editors / OS ----
# `.vscode/*` not `.vscode/`: git will not descend into a fully-excluded
# directory, so the re-includes below would never match.
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ---- Secrets / local config ----
.env
.env.*
!.env.example
*.local.yaml
*.local.toml
secrets/
.bashrc

# ---- ML / experiments ----
wandb/
runs/
lightning_logs/
tb_logs/
checkpoints/
*.pt
*.pth
*.ckpt
*.onnx
*.safetensors
!checkpoints/.gitkeep

# ---- Data / logs ----
# Bench and sysid telemetry. Use LFS or external storage for reference logs.
data/
logs/
*.csv
*.parquet
*.feather
*.h5
*.hdf5
*.tfrecord
*.bag
*.rrd
!tests/**/*.csv
!tests/**/fixtures/**

# ---- Plots / media output ----
*.png
*.jpg
*.jpeg
*.gif
*.mp4
*.mov
!docs/**/*.png
!docs/**/*.jpg
!docs/**/*.gif
!docs/**/*.mp4
!assets/**

# ---- CAD / 3D / mesh outputs ----
# Big binary geometry. Use Git LFS or link to Onshape instead.
*.stl
*.STL
*.step
*.STEP
*.stp
*.3mf
*.f3d
*.ipt
*.iam
*.sldprt
*.sldasm
*.x_t
*.x_b
*.gcode
*.3mf.gcode
# Finn's meshes are small and committed so the sim runs on a fresh clone.
!sim/model/finn/assets/*.stl

# ---- Sim / robotics artifacts ----
# Generated sim output is disposable except the seeded bundle the sim loads by
# default. Single-level `/*` globs, not `/**`, or git cannot re-include `latest/`.
sim/generated/*
!sim/generated/seeded
sim/generated/seeded/*
!sim/generated/seeded/latest
urdf/generated/
*.mjb            # MuJoCo binary model cache
mujoco_log.txt
isaac_sim_logs/

# ---- Firmware build output ----
.pio/
.pioenvs/
.piolibdeps/
.platformio/
firmware/finn-mcu/.cache/
build/
*.hex
*.elf
*.bin
*.map
*.lst

# ---- Misc ----
*.log
*.tmp
*.bak
*~
